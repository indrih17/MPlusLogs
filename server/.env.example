# Create a confidential WCL application; register the exact backend callback URL.
# Use http://localhost:8080/auth/callback for local Docker testing.
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
# Production only: bare DNS name, e.g. profiles.example.com (no scheme or path).
MPLUSLOGS_DOMAIN=
# Optional metrics authorization. Generate a long random token; never publish it.
MPLUSLOGS_ADMIN_TOKEN=
MPLUSLOGS_USER_HOURLY=60
MPLUSLOGS_USER_DAILY=300
# Each account can consume at most this share of the known hourly WCL allowance.
MPLUSLOGS_USER_POINT_FRACTION=0.2
MPLUSLOGS_GLOBAL_HOURLY=500
